# Meta Model API key from dev.meta.ai (format LLM|<number>|<secret>). Set it in Vercel, never commit it.
MODEL_API_KEY=
# Shared token the iOS app sends as x-fursight-app, so randoms can't spend our credits.
FURSIGHT_APP_TOKEN=
# Optional override, default muse-spark-1.3 (Standard mode: Meta doesn't train on our pet photos).
SPARK_MODEL=
# Same secret as the hub (cam/.dev.vars and wrangler secret HUB_KEY): signs and checks device tokens.
HUB_KEY=
# Optional: a hub other than the deployed one, e.g. http://localhost:8788 for wrangler dev.
HUB_URL=
